#include <iostream>
using namespace std;

int main() {
    int n;
    cout << "Cuantos terminos: ";
    cin >> n;
    long long f[n];
    for (int i = 0; i < n; i++) {
        if (i < 2)
            f[i] = i;
        else
            f[i] = f[i - 1] + f[i - 2];
    }
    for (int i = 0; i < n; i++) {
        cout << f[i] << " ";
    }
    cout << endl;
    return 0;
}
