#include <iostream>
using namespace std;

int main() {
    int n, x, pos = -1;
    cout << "Tamano N: ";
    cin >> n;
    int a[n];
    for (int i = 0; i < n; i++) {
        cout << "Numero " << i + 1 << ": ";
        cin >> a[i];
    }
    cout << "Numero a buscar: ";
    cin >> x;
    for (int i = 0; i < n; i++) {
        if (a[i] == x) {
            pos = i;
            break;
        }
    }
    if (pos != -1)
        cout << "Primera aparicion en la posicion " << pos << endl;
    else
        cout << "El numero no esta en el arreglo" << endl;
    return 0;
}
