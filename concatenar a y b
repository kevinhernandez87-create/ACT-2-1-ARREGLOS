#include <iostream>
using namespace std;

int main() {
    int A[5], B[5], C[10];
    cout << "Arreglo A:" << endl;
    for (int i = 0; i < 5; i++) {
        cout << "A[" << i << "]: ";
        cin >> A[i];
    }
    cout << "Arreglo B:" << endl;
    for (int i = 0; i < 5; i++) {
        cout << "B[" << i << "]: ";
        cin >> B[i];
    }
    for (int i = 0; i < 5; i++) {
        C[i] = A[i];
        C[i + 5] = B[i];
    }
    cout << "C: ";
    for (int i = 0; i < 10; i++) {
        cout << C[i] << " ";
    }
    cout << endl;
    return 0;
}
