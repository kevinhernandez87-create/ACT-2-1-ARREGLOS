#include <iostream>
using namespace std;

int main() {
    int a[12];
    for (int i = 0; i < 12; i++) {
        cout << "Numero " << i + 1 << ": ";
        cin >> a[i];
    }
    int max = a[0], pos = 0;
    for (int i = 1; i < 12; i++) {
        if (a[i] > max) {
            max = a[i];
            pos = i;
        }
    }
    cout << "Maximo: " << max << " en la posicion " << pos << endl;
    return 0;
}
