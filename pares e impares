#include <iostream>
using namespace std;

int main() {
    int n, pares = 0, impares = 0;
    cout << "Tamano N: ";
    cin >> n;
    int a[n];
    for (int i = 0; i < n; i++) {
        cout << "Numero " << i + 1 << ": ";
        cin >> a[i];
        if (a[i] % 2 == 0)
            pares++;
        else
            impares++;
    }
    cout << "Pares: " << pares << endl;
    cout << "Impares: " << impares << endl;
    return 0;
}
