#include <iostream>
using namespace std;

int main() {
    int n;
    cout << "Tamano N: ";
    cin >> n;
    int a[n];
    for (int i = 0; i < n; i++) {
        cout << "Numero " << i + 1 << ": ";
        cin >> a[i];
    }
    int primero = a[0];
    for (int i = 0; i < n - 1; i++) {
        a[i] = a[i + 1];
    }
    a[n - 1] = primero;
    cout << "Rotado: ";
    for (int i = 0; i < n; i++) {
        cout << a[i] << " ";
    }
    cout << endl;
    return 0;
}
